# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Real keys NEVER go in git.
# docker-compose reads this file automatically.
# ---------------------------------------------------------------------------

# LLM key pool — at least 2 keys, comma-separated.
# Key ids become key_1, key_2, ... in this order.
# Create Groq keys at https://console.groq.com/keys (you can make several).
LLM_API_KEYS=your_first_groq_key,your_second_groq_key

# LiteLLM model used for all keys. Pick one your Groq account has access to
# (check with: curl -H "Authorization: Bearer $KEY" https://api.groq.com/openai/v1/models).
# Common options: groq/openai/gpt-oss-20b (fast), groq/openai/gpt-oss-120b,
# groq/llama-3.3-70b-versatile, groq/llama-3.1-8b-instant
LITELLM_MODEL=groq/openai/gpt-oss-20b

# Optional: per-key models, comma-separated and parallel to LLM_API_KEYS.
# If unset, every key uses LITELLM_MODEL. Handy to spread across models:
# LLM_MODELS=groq/openai/gpt-oss-20b,groq/openai/gpt-oss-120b
# (Other providers also work out of the box, e.g. gemini/gemini-2.0-flash.)

# SQLite location. In Docker this points at the /data named volume.
DATABASE_URL=sqlite:////data/app.db

# CORS: comma-separated allowed origins (your deployed frontend URL in prod).
ALLOWED_ORIGINS=http://localhost:3000

# Enables the X-Simulate-Failure test hook. Must be true on the deployment
# to demonstrate failover on demand.
ENABLE_FAILURE_SIMULATION=true

# Default system prompt (overridable per session via the /chat system_prompt field).
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Cache backend: "local" (in-memory) or "disk" (persisted under CACHE_DIR).
CACHE_TYPE=local
# CACHE_DIR=/data/litellm_cache

# Set true to run with echo replies and no real provider calls (local demo/dev).
LLM_FAKE_MODE=false

# Misc tuning.
LLM_REQUEST_TIMEOUT=30
MAX_HISTORY_MESSAGES=40

# Frontend build-time API base URL (the browser calls this).
VITE_API_BASE_URL=http://localhost:8000
