# Normalize line endings: LF in the repo for everything text.
* text=auto eol=lf

# These MUST stay LF to run on Linux containers/CI.
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Treat known binaries as binary.
*.pdf binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
